{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd erp-frontend/erp-system && npm install --include=dev && npm run build",
  "outputDirectory": "erp-frontend/erp-system/dist",
  "installCommand": "cd erp-frontend/erp-system && npm install --include=dev",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
